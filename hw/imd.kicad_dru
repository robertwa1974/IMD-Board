(version 1)
# Generated by gen_pcb.py. HV netclass = 2.5 mm to everything (IEC 60664-1, PD2,
# material group III, 500 V row). Neighbouring nodes of one resistor string differ by at
# most 1/4 of the pack voltage (112 V at 450 V): 0.5 mm there (125 V row: 0.4 mm basic).
# Netclass and these rules apply on both copper layers, zone fills included.
(rule "VBUS HV_P-VBUS_1" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'HV_P' && B.NetName == 'VBUS_1') || (A.NetName == 'VBUS_1' && B.NetName == 'HV_P')"))
(rule "VBUS VBUS_1-VBUS_2" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'VBUS_1' && B.NetName == 'VBUS_2') || (A.NetName == 'VBUS_2' && B.NetName == 'VBUS_1')"))
(rule "VBUS VBUS_2-VBUS_3" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'VBUS_2' && B.NetName == 'VBUS_3') || (A.NetName == 'VBUS_3' && B.NetName == 'VBUS_2')"))
(rule "VBUS VBUS_3-VBUS_DIV" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'VBUS_3' && B.NetName == 'VBUS_DIV') || (A.NetName == 'VBUS_DIV' && B.NetName == 'VBUS_3')"))
(rule "R0P HV_P-R0P_1" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'HV_P' && B.NetName == 'R0P_1') || (A.NetName == 'R0P_1' && B.NetName == 'HV_P')"))
(rule "R0P R0P_1-R0P_2" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'R0P_1' && B.NetName == 'R0P_2') || (A.NetName == 'R0P_2' && B.NetName == 'R0P_1')"))
(rule "R0P R0P_2-R0P_3" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'R0P_2' && B.NetName == 'R0P_3') || (A.NetName == 'R0P_3' && B.NetName == 'R0P_2')"))
(rule "R0P R0P_3-R0P_SW" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'R0P_3' && B.NetName == 'R0P_SW') || (A.NetName == 'R0P_SW' && B.NetName == 'R0P_3')"))
(rule "VE E-VE_1" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'E' && B.NetName == 'VE_1') || (A.NetName == 'VE_1' && B.NetName == 'E')"))
(rule "VE VE_1-VE_2" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'VE_1' && B.NetName == 'VE_2') || (A.NetName == 'VE_2' && B.NetName == 'VE_1')"))
(rule "VE VE_2-VE_3" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'VE_2' && B.NetName == 'VE_3') || (A.NetName == 'VE_3' && B.NetName == 'VE_2')"))
(rule "VE VE_3-VE_DIV" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'VE_3' && B.NetName == 'VE_DIV') || (A.NetName == 'VE_DIV' && B.NetName == 'VE_3')"))
(rule "VKE KE-VKE_1" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'KE' && B.NetName == 'VKE_1') || (A.NetName == 'VKE_1' && B.NetName == 'KE')"))
(rule "VKE VKE_1-VKE_2" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'VKE_1' && B.NetName == 'VKE_2') || (A.NetName == 'VKE_2' && B.NetName == 'VKE_1')"))
(rule "VKE VKE_2-VKE_3" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'VKE_2' && B.NetName == 'VKE_3') || (A.NetName == 'VKE_3' && B.NetName == 'VKE_2')"))
(rule "VKE VKE_3-VKE_DIV" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'VKE_3' && B.NetName == 'VKE_DIV') || (A.NetName == 'VKE_DIV' && B.NetName == 'VKE_3')"))
(rule "R0N R0N_SW-R0N_1" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'R0N_SW' && B.NetName == 'R0N_1') || (A.NetName == 'R0N_1' && B.NetName == 'R0N_SW')"))
(rule "R0N R0N_1-R0N_2" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'R0N_1' && B.NetName == 'R0N_2') || (A.NetName == 'R0N_2' && B.NetName == 'R0N_1')"))
(rule "R0N R0N_2-R0N_3" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'R0N_2' && B.NetName == 'R0N_3') || (A.NetName == 'R0N_3' && B.NetName == 'R0N_2')"))
(rule "R0N R0N_3-GND_HV" (constraint clearance (min 0.5mm))
  (condition "(A.NetName == 'R0N_3' && B.NetName == 'GND_HV') || (A.NetName == 'GND_HV' && B.NetName == 'R0N_3')"))
# HV through-hole pins (J3 HV+, J4 E/KE) reach the bottom layer, where the GND_HV pour is:
# all non-HV copper (pour, tracks, vias, pads) stays 1 mm further back than the 2.5 mm
# netclass minimum - margin for the hand-soldered joints and flux residue on the side
# facing the economizer. HV-to-HV pairs keep their own rules above.
(rule "HV THT pad margin" (constraint clearance (min 3.5mm))
  (condition "(A.NetClass == 'HV' && A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.NetClass != 'HV') || (B.NetClass == 'HV' && B.Type == 'Pad' && B.Pad_Type == 'Through-hole' && A.NetClass != 'HV')"))
# E and KE are the same chassis potential in operation (separate wires only to detect a
# break); they sit on 3 mm connector pins. 1 mm functional spacing.
(rule "E-KE" (constraint clearance (min 1.0mm))
  (condition "(A.NetName == 'E' && B.NetName == 'KE') || (A.NetName == 'KE' && B.NetName == 'E')"))
